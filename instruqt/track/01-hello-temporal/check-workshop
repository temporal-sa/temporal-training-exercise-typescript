#!/bin/bash
# ABOUTME: Check script. Gate 1: TODOs gone. Gate 2: a greet Workflow completed and returned the greeting.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

cd /root/workshop || fail "Workshop directory is missing."
EX=exercise1/src
STAMP_FILE=/tmp/workshop-challenge-01.started

# ID of the most recent Workflow matching the visibility query in $1 that
# started after this challenge's setup ran. Exercises 2 to 8 share one task
# queue, so without the time filter a Workflow from an earlier challenge would
# satisfy this one.
latest_workflow() {
    local query="$1"
    if [ -s "$STAMP_FILE" ]; then
        query="$query AND StartTime >= \"$(cat "$STAMP_FILE")\""
    fi
    temporal workflow list \
        --address 127.0.0.1:7233 --namespace default \
        --query "$query" --limit 1 -o json 2>/dev/null \
        | jq -r '.[0].execution.workflowId // empty' 2>/dev/null
}

# Full event history of the Workflow in $1, as JSON.
history_json() {
    temporal workflow show \
        --address 127.0.0.1:7233 --namespace default \
        --workflow-id "$1" -o json 2>/dev/null
}

no_todos() {
    for f in "$@"; do
        if grep -q "TODO" "$EX/$f" 2>/dev/null; then
            fail "$f still has TODO comments. Implement them, delete the comments, then check again."
        fi
    done
    pass "All TODOs implemented"
}

no_todos activities.ts workflow.ts worker/index.ts

WF_ID=$(latest_workflow 'TaskQueue="hello-task-queue" AND ExecutionStatus="Completed"')
if [ -z "$WF_ID" ]; then
    fail "No Workflow has completed on hello-task-queue since this challenge started. Start the Worker, run the starter, and wait for the greeting to print."
fi
pass "Workflow $WF_ID completed on hello-task-queue"

if ! temporal workflow result --address 127.0.0.1:7233 --namespace default \
        --workflow-id "$WF_ID" 2>/dev/null | grep -q "Hello, Temporal!"; then
    fail "Workflow $WF_ID completed, but its result is not \"Hello, Temporal!\". Check the greeting format in createGreeting and that greet returns the Activity result."
fi
pass "Workflow returned \"Hello, Temporal!\""
