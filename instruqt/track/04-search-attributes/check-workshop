#!/bin/bash
# ABOUTME: Check script. Gate 1: TODOs gone. Gate 2: a Workflow is findable by both search attributes, which only happens if the start-time attribute and the upserts both worked.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

cd /root/workshop || fail "Workshop directory is missing."
EX=exercise4/src
STAMP_FILE=/tmp/workshop-challenge-04.started

# ID of the most recent Workflow matching the visibility query in $1 that
# started after this challenge's setup ran. Exercises 2 to 8 share one task
# queue, so without the time filter a Workflow from an earlier challenge would
# satisfy this one.
latest_workflow() {
    local query="$1"
    if [ -s "$STAMP_FILE" ]; then
        query="$query AND StartTime >= \"$(cat "$STAMP_FILE")\""
    fi
    temporal workflow list \
        --address 127.0.0.1:7233 --namespace default \
        --query "$query" --limit 1 -o json 2>/dev/null \
        | jq -r '.[0].execution.workflowId // empty' 2>/dev/null
}

# Full event history of the Workflow in $1, as JSON.
history_json() {
    temporal workflow show \
        --address 127.0.0.1:7233 --namespace default \
        --workflow-id "$1" -o json 2>/dev/null
}

no_todos() {
    for f in "$@"; do
        if grep -q "TODO" "$EX/$f" 2>/dev/null; then
            fail "$f still has TODO comments. Implement them, delete the comments, then check again."
        fi
    done
    pass "All TODOs implemented"
}

no_todos workflow.ts starter/index.ts

if ! grep -q "upsertSearchAttributes" "$EX/workflow.ts" 2>/dev/null; then
    fail "workflow.ts never calls upsertSearchAttributes()."
fi
pass "upsertSearchAttributes called"

WF_ID=$(latest_workflow 'AccountId="account-123" AND TransferStatus="COMPLETED"')
if [ -z "$WF_ID" ]; then
    fail "No Workflow started since this challenge began carries AccountId=\"account-123\" and TransferStatus=\"COMPLETED\". Set AccountId in the starter, upsert TransferStatus as the Workflow progresses, then run it again."
fi
pass "Workflow $WF_ID found by AccountId and TransferStatus"
