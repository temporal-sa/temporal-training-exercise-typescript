#!/bin/bash
# ABOUTME: Check script. Gate 1: TODOs gone. Gate 2: three summaries in code. Gate 3: a transfer completed with summaries in its history.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

cd /root/workshop || fail "Workshop directory is missing."
EX=exercise5/src
STAMP_FILE=/tmp/workshop-challenge-05.started

# ID of the most recent Workflow matching the visibility query in $1 that
# started after this challenge's setup ran. Exercises 2 to 8 share one task
# queue, so without the time filter a Workflow from an earlier challenge would
# satisfy this one.
latest_workflow() {
    local query="$1"
    if [ -s "$STAMP_FILE" ]; then
        query="$query AND StartTime >= \"$(cat "$STAMP_FILE")\""
    fi
    temporal workflow list \
        --address 127.0.0.1:7233 --namespace default \
        --query "$query" --limit 1 -o json 2>/dev/null \
        | jq -r '.[0].execution.workflowId // empty' 2>/dev/null
}

# Full event history of the Workflow in $1, as JSON.
history_json() {
    temporal workflow show \
        --address 127.0.0.1:7233 --namespace default \
        --workflow-id "$1" -o json 2>/dev/null
}

no_todos() {
    for f in "$@"; do
        if grep -q "TODO" "$EX/$f" 2>/dev/null; then
            fail "$f still has TODO comments. Implement them, delete the comments, then check again."
        fi
    done
    pass "All TODOs implemented"
}

no_todos workflow.ts

SUMMARIES=$(grep -c "summary:" "$EX/workflow.ts" 2>/dev/null || true)
if [ "${SUMMARIES:-0}" -lt 3 ]; then
    fail "Found ${SUMMARIES:-0} summary: options in workflow.ts. withdraw, deposit and refund each need their own proxyActivities call with a summary."
fi
pass "All three Activities carry a summary"

WF_ID=$(latest_workflow 'TaskQueue="money-transfer-task-queue" AND ExecutionStatus="Completed"')
if [ -z "$WF_ID" ]; then
    fail "No money transfer Workflow has completed since this challenge started. Start the Worker, run the starter, and wait for the result to print."
fi
pass "Money transfer Workflow $WF_ID completed"

if ! history_json "$WF_ID" | grep -q '"userMetadata"'; then
    fail "Workflow $WF_ID completed, but its Activities were scheduled without a summary. Restart the Worker so it picks up the new code, then run the starter again."
fi
pass "Activity summaries recorded in the event history"
