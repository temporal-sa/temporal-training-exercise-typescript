#!/bin/bash
# ABOUTME: Check script. Gate 1: the test file exists with no TODOs. Gate 2: it Signals, Queries and asserts. Gate 3: mocha passes all three tests.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

cd /root/workshop || fail "Workshop directory is missing."
EX=exercise6/src
STAMP_FILE=/tmp/workshop-challenge-06.started

# ID of the most recent Workflow matching the visibility query in $1 that
# started after this challenge's setup ran. Exercises 2 to 8 share one task
# queue, so without the time filter a Workflow from an earlier challenge would
# satisfy this one.
latest_workflow() {
    local query="$1"
    if [ -s "$STAMP_FILE" ]; then
        query="$query AND StartTime >= \"$(cat "$STAMP_FILE")\""
    fi
    temporal workflow list \
        --address 127.0.0.1:7233 --namespace default \
        --query "$query" --limit 1 -o json 2>/dev/null \
        | jq -r '.[0].execution.workflowId // empty' 2>/dev/null
}

# Full event history of the Workflow in $1, as JSON.
history_json() {
    temporal workflow show \
        --address 127.0.0.1:7233 --namespace default \
        --workflow-id "$1" -o json 2>/dev/null
}

no_todos() {
    for f in "$@"; do
        if grep -q "TODO" "$EX/$f" 2>/dev/null; then
            fail "$f still has TODO comments. Implement them, delete the comments, then check again."
        fi
    done
    pass "All TODOs implemented"
}

TEST="$EX/workflow.test.ts"

if [ ! -f "$TEST" ]; then
    fail "exercise6/src/workflow.test.ts is missing. Create it from the scaffold described in the assignment."
fi
no_todos workflow.test.ts

if ! grep -q "query(getStatusQuery" "$TEST" 2>/dev/null; then
    fail "workflow.test.ts never Queries getStatusQuery. Assert on the status before approving."
fi
ASSERTS=$(grep -c "assert\." "$TEST" 2>/dev/null || true)
if [ "${ASSERTS:-0}" -lt 3 ]; then
    fail "workflow.test.ts has ${ASSERTS:-0} assertions. Each of the three tests needs one."
fi
pass "Tests Signal, Query and assert"

if ! OUT=$(timeout 300 npx mocha --exit "$TEST" --require ts-node/register --timeout 60000 2>&1); then
    echo "$OUT" | tail -30
    fail "The exercise 6 tests did not pass. Fix the failures above, then check again."
fi
PASSING=$(echo "$OUT" | grep -oE "[0-9]+ passing" | grep -oE "[0-9]+" || echo 0)
if [ "${PASSING:-0}" -lt 3 ]; then
    echo "$OUT" | tail -15
    fail "Only ${PASSING:-0} tests passed. All three scenarios need a test."
fi
pass "All $PASSING tests pass"
echo "$OUT" | tail -8
