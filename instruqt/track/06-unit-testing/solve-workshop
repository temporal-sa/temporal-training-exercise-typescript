#!/bin/bash
# ABOUTME: Solve script. Mimics a learner solving the challenge.
# Runs on Skip and on `instruqt track test`. It must leave the check passing:
# copy the finished test file in and run it.
set -uo pipefail
cd /root/workshop || exit 0

# Start the Worker in the background and wait until it is polling. ts-node
# compiles and the Worker bundles the Workflow code first, which takes a
# while; a Query sent before the Worker polls fails with "no poller seen".
start_worker() {
    pkill -f "src/worker/index.ts" 2>/dev/null || true
    sleep 1
    nohup npx ts-node exercise6/src/worker/index.ts > /tmp/solve-06-worker.log 2>&1 &
    WORKER_PID=$!
    for _ in $(seq 1 120); do
        grep -q "RUNNING" /tmp/solve-06-worker.log 2>/dev/null && return 0
        sleep 1
    done
    echo "Worker did not report RUNNING within 120s; continuing anyway."
}

cp solution6/src/workflow.test.ts exercise6/src/workflow.test.ts

timeout 300 npx mocha --exit exercise6/src/workflow.test.ts \
    --require ts-node/register --timeout 60000 || true

exit 0
